{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrderlyDesk",
  "version": "0.0.0",
  "identifier": "com.orderlydesk.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @orderlydesk/web dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @orderlydesk/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "OrderlyDesk 接单台",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* https://*"
    }
  },
  "bundle": {
    "active": false
  }
}
